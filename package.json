{
  "name": "ellie",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev -w @ellie/server",
    "predev": "npm run build -w @ellie/schema",
    "build": "npm run build -w @ellie/schema && npm run build:ui && npm run build -w @ellie/server",
    "build:ui": "npm run build -w @ellie/ui && npm run build -w @ellie/phone && npm run build -w @ellie/mcp-app",
    "dev:phone": "npm run dev -w @ellie/phone",
    "dev:all": "concurrently -n server,phone \"npm run dev\" \"npm run dev:phone\"",
    "start": "npm run start -w @ellie/server",
    "pretest": "npm run build",
    "pretypecheck": "npm run build",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:packs": "npm run validate:packs -w @ellie/schema",
    "gen:jsonschema": "npm run gen:jsonschema -w @ellie/schema",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "db:create": "tsx scripts/create-table.ts",
    "db:local": "docker compose up -d dynamodb-local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke.ts",
    "aws:env": "tsx scripts/print-env-from-stack.ts",
    "aws:check": "tsx scripts/aws-check.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5.6",
    "typescript-eslint": "^8"
  }
}

{
  "name": "ellie",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm run dev -w @ellie/server",
    "predev": "npm run build -w @ellie/schema",
    "build": "npm run build -w @ellie/schema && npm run build -w @ellie/server",
    "start": "npm run start -w @ellie/server",
    "pretest": "npm run build -w @ellie/schema",
    "pretypecheck": "npm run build -w @ellie/schema",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "validate:packs": "npm run validate:packs -w @ellie/schema",
    "gen:jsonschema": "npm run gen:jsonschema -w @ellie/schema",
    "seed": "tsx scripts/seed.ts",
    "seed:reset": "tsx scripts/seed.ts --reset",
    "db:create": "tsx scripts/create-table.ts",
    "db:local": "docker compose up -d dynamodb-local",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "tsx scripts/smoke.ts",
    "inspector": "npx @modelcontextprotocol/inspector"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "eslint": "^9",
    "globals": "^15",
    "prettier": "^3",
    "tsx": "^4",
    "typescript": "^5.6",
    "typescript-eslint": "^8"
  }
}

# Core
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
LOG_LEVEL=info
ELLIE_PUBLIC_BASE_URL=http://localhost:8787
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ELLIE_FAKE_NOW=
DEFAULT_HOUSEHOLD_ID=demo-blr

# Driver switches: auto | mock | aws
STORAGE_DRIVER=auto
LLM_DRIVER=auto
NOTIFY_DRIVER=auto
SCHEDULER_DRIVER=auto
MOCK_STORAGE_MODE=file
DATA_DIR=./data
REGION_PACKS_DIR=

# Memory (Module 3)
SEED_ON_START=true
SEED_ANCHOR_DATE=
EVENT_DEDUPE_WINDOW_SEC=120
DYNAMODB_TEST=false

# AWS common
AWS_REGION=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# DynamoDB (Module 3)
DYNAMODB_TABLE_NAME=
DYNAMODB_ENDPOINT=

# Bedrock (Module 5)
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=600

# Diagnosis (Module 5)
LLM_VOICE_TIMEOUT_MS=350
LLM_BACKGROUND_TIMEOUT_MS=8000
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=
DIAGNOSIS_SESSION_TTL_HOURS=24

# SNS (Module 6)
SNS_TOPIC_ARN=
SNS_SMS_ENABLED=false
SNS_SMS_SENDER_ID=
SNS_SMS_ENTITY_ID=
SNS_SMS_TEMPLATE_ID=
SNS_SMS_TYPE=Transactional

# EventBridge Scheduler (Module 6)
EVENTBRIDGE_SCHEDULE_GROUP=ellie
EVENTBRIDGE_TARGET_ARN=
EVENTBRIDGE_ROLE_ARN=
SCHEDULER_QUEUE_URL=
SCHEDULER_POLL_WAIT_SEC=20

# Phone page / links (Module 6-7)
PHONE_PAGE_BASE_URL= # Optional; blank uses the local /phone/ build when available
LINK_SIGNING_SECRET=change-me-in-production
PHONE_LINK_TTL_HOURS=72
SHORT_LINK_BASE_URL=
PHONE_SEND_LIMIT_PER_HOUR=10

# OAuth 2.1 (Module 9, optional)
OAUTH_ENABLED=false
OAUTH_ISSUER_URL=
OAUTH_AUDIENCE=

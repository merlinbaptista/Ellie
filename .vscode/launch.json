{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Ellie server",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "packages/server/src/index.ts"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Open simulator",
      "type": "pwa-chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8787/sim/",
      "webRoot": "${workspaceFolder}/packages/simulator"
    }
  ]
}
